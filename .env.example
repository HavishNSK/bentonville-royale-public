# Bentonville Royale: optional local settings. Copy to .env.local (git-ignored) and fill in.
#
# Optional "Real-world 3D view (Google)" (Settings menu, off by default).
# Streams Google Photorealistic 3D Tiles around Bentonville; purely visual.
#
# 1. Google Cloud console: create/select a project and enable billing on it.
# 2. APIs & Services > Library: enable "Map Tiles API".
# 3. APIs & Services > Credentials: create an API key, then restrict it:
#      - Application restrictions: Websites (HTTP referrers) -> http://localhost:5173/*
#      - API restrictions: Map Tiles API only
# 4. Put the key below in .env.local and restart `npm run dev`.
#
# Vite inlines every VITE_* variable into the client bundle: a key used in a deployed
# build is visible to anyone. Leave it unset for deploys (the toggle is then disabled
# and nothing is requested from Google), or use a separate, referrer-restricted key.
VITE_GOOGLE_MAPS_API_KEY=

# Party / accounts Cloudflare Worker host (no https://). Required for production multiplayer.
# Example: bentonville-royale.bentonville-royale.workers.dev
VITE_PARTYKIT_HOST=

# Optional Continue with Google (GIS). Read by Vite into the browser bundle (public).
# Create an OAuth Web client ID; authorize http://localhost:5173 and your prod origin.
# Set the same ID as Worker GOOGLE_CLIENT_ID. Placeholder only — no secrets. User: google auth.
VITE_GOOGLE_CLIENT_ID=

# Optional Log in with Clever (school SSO). Public flag/client id in the browser bundle.
# 1. Create a Clever app; set Redirect URI to:
#      https://bentonville-royale.bentonville-royale.workers.dev/auth/clever/callback
# 2. Worker: CLEVER_CLIENT_ID (wrangler vars) + CLEVER_CLIENT_SECRET (`wrangler secret put`)
# 3. Client: VITE_CLEVER_AUTH=1 (or VITE_CLEVER_CLIENT_ID=your-id) then rebuild.
# Never put CLEVER_CLIENT_SECRET in VITE_* or git.
VITE_CLEVER_AUTH=
VITE_CLEVER_CLIENT_ID=
