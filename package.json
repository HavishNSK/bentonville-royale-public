{
  "name": "bentonville-royale",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "An original third-person building battle royale set in real Bentonville, Arkansas.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fetch-map": "node scripts/fetch-map-data.mjs && node scripts/compose-map.mjs",
    "compose-map": "node scripts/compose-map.mjs",
    "party:dev": "wrangler dev",
    "party:deploy": "wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "check:interiors": "node scripts/check-interiors.mjs",
    "check:stairs": "node scripts/check-stairs.mjs"
  },
  "devDependencies": {
    "geotiff": "^2.1.3",
    "sharp": "^0.33.5",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "3d-tiles-renderer": "0.5.3",
    "partyserver": "^0.5.10",
    "three": "^0.187.0"
  }
}
