{
  // Multiplayer relay: PartyServer on Cloudflare Workers (free plan: SQLite-backed Durable Objects).
  // Deploy: npm run party:deploy   Local: npm run party:dev (port 1999)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bentonville-royale",
  "main": "party/server.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "Main", "class_name": "Main" },
      { "name": "Party", "class_name": "Party" },
      { "name": "Matchmaker", "class_name": "Matchmaker" },
      { "name": "Accounts", "class_name": "Accounts" },
      { "name": "Presence", "class_name": "Presence" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Main"] },
    { "tag": "v2", "new_sqlite_classes": ["Party", "Matchmaker"] },
    { "tag": "v3", "new_sqlite_classes": ["Accounts"] },
    { "tag": "v4", "new_sqlite_classes": ["Presence"] }
  ],
  // Public OAuth client ID (not a secret).
  "vars": {
    "GOOGLE_CLIENT_ID": "938917087479-mktkhe12uc4hmr95cn14uqekohr3tfrl.apps.googleusercontent.com"
  },
  "dev": { "port": 1999 }
}
